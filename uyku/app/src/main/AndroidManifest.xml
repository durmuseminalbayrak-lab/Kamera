<?xml version="1.0" encoding="utf-8"?>
<!-- İnternet izni YOK: uygulama hiçbir veriyi dışarı gönderemez. Ses kaydedilmez, yalnızca ölçülür. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Yankıları dinlemek için (ses kaydı tutulmaz) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Gece boyunca ekran kapalıyken çalışmak için -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Uyku"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".SleepService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
